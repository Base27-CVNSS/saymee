{
  "manifest_version": 3,
  "name": "Saymee Live STT",
  "short_name": "Saymee",
  "description": "Chép lời trực tiếp từ âm thanh tab hoặc microphone bằng Deepgram và Chrome Speech.",
  "version": "1.1.0",
  "author": "Long Ngo",
  "homepage_url": "https://github.com/Base27-CVNSS/saymee",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "desktopCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mở Saymee Live STT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* wss:"
  }
}
